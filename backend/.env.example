# ─── Resume Screener API – environment variables ───────────────────────────
#
# Copy this file to .env and fill in the values.
# Never commit the real .env file.
#
# ─── Server ──────────────────────────────────────────────────────────────────

# Port the Uvicorn server listens on.
# Render injects PORT automatically — leave this unset when deploying to Render.
# The container falls back to 10000 when PORT is not set.
# PORT=10000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Set ONE of the two variables below in the Render environment settings.
# In development both localhost:3000 and localhost:5173 are allowed
# automatically, so you only need to set this for production.

# Single production origin (your Lovable / frontend URL):
# FRONTEND_URL=https://your-app.lovable.app

# Multiple origins (comma-separated):
# FRONTEND_URLS=https://your-app.lovable.app,https://staging.your-app.lovable.app

# ─── ML model ────────────────────────────────────────────────────────────────
# Cosine-similarity threshold above which a resume is considered a match.
# Default: 0.50  (range: 0.0–1.0)
MATCH_THRESHOLD=0.50
